{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve preview (PowerShell)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/serve-preview.ps1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "preview-server",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^SERVER · listening:",
          "endsPattern": "^PREVIEW_READY$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    }
  ]
}
